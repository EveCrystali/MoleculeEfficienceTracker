<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net9.0-maccatalyst a été retiré : aucun dossier Platforms/MacCatalyst
		     n'a jamais existé, et comme il était le premier de la liste, un
		     `dotnet build` sans cible échouait sur toute machine non-macOS. -->
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MoleculeEfficienceTracker</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Molecule Tracker</ApplicationTitle>

		<!-- Identifiant réel : le modèle laissait com.companyname.*, qui interdit
		     toute publication et entre en collision avec n'importe quelle autre
		     application issue du même modèle. -->
		<ApplicationId>com.evecrystali.moleculeefficiencetracker</ApplicationId>

		<ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Clé de licence Syncfusion.

	     Elle n'est jamais écrite dans le dépôt : elle arrive par la variable
	     d'environnement SYNCFUSION_LICENSE_KEY au moment de la compilation et se
	     retrouve en métadonnée d'assemblage, lue au démarrage. Sans clé, la
	     compilation passe et l'application affiche le bandeau d'essai. -->
	<PropertyGroup>
		<SyncfusionLicenseKey Condition="'$(SyncfusionLicenseKey)' == ''">$(SYNCFUSION_LICENSE_KEY)</SyncfusionLicenseKey>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SyncfusionLicense</_Parameter1>
			<_Parameter2>$(SyncfusionLicenseKey)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Le glob implicite du SDK ramassait tests/**/*.cs dans l'application. -->
	<ItemGroup>
		<Compile Remove="tests/**/*.cs" />
		<None Remove="tests/**" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F5FAF" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F5FAF" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />

		<!-- Restreint aux vraies polices : le glob d'origine embarquait aussi
		     FluentUI.cs, un fichier source de 526 Ko, comme s'il s'agissait d'une
		     police. -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Syncfusion.Maui.Charts" Version="34.2.7" />
		<PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
	</ItemGroup>

</Project>
