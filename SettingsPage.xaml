<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoleculeEfficienceTracker.SettingsPage"
             Title="Réglages">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Vous" Style="{StaticResource SectionTitleStyle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <Label Text="Poids (kg)" Style="{StaticResource BodyLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Entry x:Name="WeightEntry" Keyboard="Numeric" Placeholder="72"
                               Style="{StaticResource FieldEntryStyle}"
                               SemanticProperties.Description="Poids en kilogrammes" />
                    </Border>

                    <Label Text="Sexe" Style="{StaticResource BodyLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Picker x:Name="SexPicker"
                                Style="{StaticResource FieldPickerStyle}"
                                SemanticProperties.Description="Sexe, utilisé pour le coefficient de diffusion de l'alcool">
                            <Picker.Items>
                                <x:String>Homme</x:String>
                                <x:String>Femme</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Café et sommeil" Style="{StaticResource SectionTitleStyle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <Label Text="Heure de coucher visée" Style="{StaticResource BodyLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <TimePicker x:Name="BedTimePicker" Format="HH:mm"
                                    Style="{StaticResource FieldTimePickerStyle}"
                                    SemanticProperties.Description="Heure de coucher visée" />
                    </Border>

                    <Label Text="Caféine tolérée au coucher (mg/L)" Style="{StaticResource BodyLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Entry x:Name="SleepThresholdEntry" Keyboard="Numeric" Placeholder="1,0"
                               Style="{StaticResource FieldEntryStyle}" />
                    </Border>
                    <Label Text="Repère : un Nespresso de 80 mg culmine autour de 1,5 mg/L."
                           Style="{StaticResource HelperLabelStyle}" />

                    <Label Text="Doses en accès direct (mg, séparées par ;)" Style="{StaticResource BodyLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Entry x:Name="PresetsEntry" Placeholder="80;65;35"
                               Style="{StaticResource FieldEntryStyle}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Rappel à l'heure limite"
                               Style="{StaticResource BodyLabelStyle}" />
                        <Switch Grid.Column="1" x:Name="NotificationSwitch"
                                SemanticProperties.Description="Activer le rappel à l'heure limite du dernier café" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sauvegarde sortante" Style="{StaticResource SectionTitleStyle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <Label Text="Adresse de dépôt (laisser vide pour désactiver)"
                           Style="{StaticResource BodyLabelStyle}" />
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <Entry x:Name="BackupEndpointEntry" Keyboard="Url"
                               Placeholder="http://machine.tailnet:8080/depot"
                               Style="{StaticResource FieldEntryStyle}"
                               SemanticProperties.Description="Adresse du point de dépôt de la sauvegarde" />
                    </Border>

                    <Label Text="Envoi quotidien, dans un seul sens. Rien ne revient du serveur : il n'y a donc aucun conflit à arbitrer, et un échec est sans conséquence."
                           Style="{StaticResource HelperLabelStyle}" />

                    <Label x:Name="BackupStatusLabel" Style="{StaticResource HelperLabelStyle}" />

                    <Button Text="Envoyer maintenant" Clicked="OnBackupNowClicked"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Données" Style="{StaticResource SectionTitleStyle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <Label Text="L'import relit un fichier exporté et fusionne son contenu avec ce qui est déjà là. Une prise déjà connue n'est pas ajoutée deux fois : réimporter le même fichier ne change rien."
                           Style="{StaticResource CaptionLabelStyle}" />

                    <Button x:Name="ImportButton" Text="Importer un fichier"
                            Clicked="OnImportClicked"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    <Label x:Name="ImportStatusLabel"
                           Style="{StaticResource HelperLabelStyle}"
                           IsVisible="False" />

                    <BoxView Style="{StaticResource SeparatorStyle}" />

                    <Label x:Name="MigrationLabel" Style="{StaticResource HelperLabelStyle}" />
                    <Label Text="Cette application n'est pas un dispositif médical. Les concentrations affichées sont des estimations issues de modèles moyens, jamais une mesure."
                           Style="{StaticResource HelperLabelStyle}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Enregistrer" Clicked="OnSaveClicked"
                    Style="{StaticResource PrimaryButtonStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
