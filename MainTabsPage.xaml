<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="MoleculeEfficienceTracker.MainTabsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MoleculeEfficienceTracker">

    <!--
        Les onglets portent un mot, plus seulement un emoji. Un lecteur d'écran
        annonçait jusqu'ici « tasse à thé », « cerveau », « pansement adhésif ».
        L'onglet Paramètres déclarait en outre IconImageSource="⚙️", c'est-à-dire
        un fichier image nommé littéralement ⚙️, qui n'a jamais existé.

        La caféine passe en tête : c'est l'usage quotidien.
    -->

    <local:CaffeinePage Title="Café" />
    <local:BromazepamPage Title="Bromaz." />
    <local:PainReliefPage Title="Douleur" />
    <local:AlcoholPage Title="Alcool" />
    <local:ChargePage Title="Charge" />
    <local:SettingsPage Title="Réglages" />
</TabbedPage>
