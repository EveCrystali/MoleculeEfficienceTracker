<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="MoleculeEfficienceTracker.Controls.MoleculePanelView">

    <!--
        Corps commun à toutes les pages molécules.

        La hiérarchie, d'abord : une phrase qui répond, une jauge qui situe, une
        puce qui nomme. Puis l'ajout, la courbe, l'historique, les données. Six
        cartes de poids égal ne hiérarchisaient rien.

        La peau, ensuite. Les cartes sont de verre — translucides sur le dégradé de
        page, filet clair sur l'arête, ombre large. La carte de tête prend en plus
        la teinte de sa molécule, posée en code : c'est ce qui distingue Café
        d'Alcool avant même d'avoir lu le titre.

        Les volets repliables sont faits à la main, un bouton qui bascule une
        visibilité, plutôt qu'avec le contrôle Expander de la bibliothèque
        communautaire : celui-ci se mesure mal dans un ScrollView sur Android.
    -->

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">

            <!-- ===== 1. La réponse, avant la courbe ===== -->
            <Border x:Name="HeadlineCard" Style="{StaticResource HeroCardStyle}">
                <VerticalStackLayout Spacing="18">

                    <Label x:Name="HeadlineLabel"
                           Style="{StaticResource HeadlineAnswerStyle}"
                           MaxLines="3"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="120,*" ColumnSpacing="18">

                        <!-- La jauge et sa valeur occupent la même cellule : le
                             nombre se lit au centre de l'anneau, comme un cadran. -->
                        <Grid Grid.Column="0" WidthRequest="120" HeightRequest="120"
                              HorizontalOptions="Start" VerticalOptions="Center">
                            <GraphicsView x:Name="LevelGauge"
                                          WidthRequest="120" HeightRequest="120"
                                          InputTransparent="True" />
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="0">
                                <Label x:Name="ConcentrationLabel"
                                       Style="{StaticResource DisplayValueStyle}"
                                       SemanticProperties.Description="Valeur estimée à l'instant" />
                                <Label x:Name="ConcentrationUnitLabel"
                                       Style="{StaticResource DisplayUnitStyle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">

                            <!-- La puce d'état porte ensemble le glyphe, le mot et la
                                 couleur. Aucun des trois ne suffit seul : la couleur
                                 est inaccessible en deutéranopie, le glyphe est muet
                                 pour un lecteur d'écran. -->
                            <Border x:Name="StatusChip"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="12,7">
                                <Label x:Name="EffectStatusLabel"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <Label x:Name="ConcentrationDetailLabel"
                                   Style="{StaticResource CaptionLabelStyle}" />

                            <Label x:Name="EffectPredictionLabel"
                                   Style="{StaticResource HelperLabelStyle}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label x:Name="HeadlineDetailLabel"
                           Style="{StaticResource CaptionLabelStyle}" />

                    <Label x:Name="LastUpdateLabel"
                           Style="{StaticResource HelperLabelStyle}"
                           FontSize="11"
                           HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== 2. Saisie ===== -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">

                    <Label x:Name="AddTitleLabel"
                           Style="{StaticResource SectionTitleStyle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <!-- Accès direct : un appui suffit, sans clavier ni formulaire.
                         Les boutons partagent la largeur sur une grille. Ils
                         faisaient auparavant 104 px en dur dans une pile
                         horizontale sans repli : trois d'entre eux et les marges
                         réclamaient 396 px sur un écran de 360, et le nombre de
                         doses rapides est réglable. -->
                    <Grid x:Name="PresetsHost" ColumnSpacing="10" RowSpacing="10" IsVisible="False" />

                    <Button x:Name="DetailToggleButton"
                            Style="{StaticResource DisclosureButtonStyle}"
                            Clicked="OnDetailToggleClicked" />

                    <VerticalStackLayout x:Name="DetailForm" Spacing="14" IsVisible="False">

                        <!-- Le libellé du champ est son propre indicateur : Material 3
                             le fait flotter au-dessus du contour dès la frappe. Il
                             occupait jusqu'ici une colonne entière à gauche. -->
                        <Entry x:Name="DoseEntryControl"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Quantité de la prise" />

                        <ContentView x:Name="ExtraInputHost" />

                        <Label x:Name="HelperLabel"
                               Style="{StaticResource HelperLabelStyle}" />

                        <Label Text="Quand" Style="{StaticResource HelperLabelStyle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <DatePicker x:Name="DateControl" Grid.Column="0"
                                        SemanticProperties.Description="Date de la prise" />
                            <TimePicker x:Name="TimeControl" Grid.Column="1" Format="HH:mm"
                                        SemanticProperties.Description="Heure de la prise" />
                        </Grid>

                        <Button x:Name="AddButton"
                                Text="Ajouter la prise"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== 3. Courbe ===== -->
            <!-- Masquée tant qu'il n'y a rien à tracer : une carte vide de trois
                 cents pixels ne documente rien. -->
            <Border x:Name="ChartCard" Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Évolution"
                           Style="{StaticResource SectionTitleStyle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <chart:SfCartesianChart x:Name="ConcentrationChart"
                                            HeightRequest="250"
                                            MinimumHeightRequest="200"
                                            SemanticProperties.Description="Courbe de concentration au cours du temps">
                        <chart:SfCartesianChart.TrackballBehavior>
                            <chart:ChartTrackballBehavior DisplayMode="FloatAllPoints" />
                        </chart:SfCartesianChart.TrackballBehavior>

                        <chart:SfCartesianChart.ZoomPanBehavior>
                            <chart:ChartZoomPanBehavior ZoomMode="X" EnablePanning="True" />
                        </chart:SfCartesianChart.ZoomPanBehavior>

                        <chart:SfCartesianChart.XAxes>
                            <chart:DateTimeAxis x:Name="ChartXAxis" ShowMajorGridLines="False">
                                <chart:DateTimeAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                </chart:DateTimeAxis.LabelStyle>
                                <chart:DateTimeAxis.AxisLineStyle>
                                    <chart:ChartLineStyle StrokeWidth="0" />
                                </chart:DateTimeAxis.AxisLineStyle>
                                <chart:DateTimeAxis.MajorTickStyle>
                                    <chart:ChartAxisTickStyle StrokeWidth="0" />
                                </chart:DateTimeAxis.MajorTickStyle>
                            </chart:DateTimeAxis>
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis x:Name="ChartYAxis" Minimum="0" ShowMajorGridLines="True">
                                <chart:NumericalAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle FontSize="11"
                                        TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                </chart:NumericalAxis.LabelStyle>
                                <chart:NumericalAxis.MajorGridLineStyle>
                                    <chart:ChartLineStyle StrokeWidth="1"
                                        Stroke="{AppThemeBinding Light={StaticResource GridLineLight}, Dark={StaticResource GridLineDark}}" />
                                </chart:NumericalAxis.MajorGridLineStyle>
                                <chart:NumericalAxis.AxisLineStyle>
                                    <chart:ChartLineStyle StrokeWidth="0" />
                                </chart:NumericalAxis.AxisLineStyle>
                                <chart:NumericalAxis.MajorTickStyle>
                                    <chart:ChartAxisTickStyle StrokeWidth="0" />
                                </chart:NumericalAxis.MajorTickStyle>
                            </chart:NumericalAxis>
                        </chart:SfCartesianChart.YAxes>

                        <!-- Aire plutôt que ligne : la surface sous la courbe dit la
                             charge accumulée, qu'un trait de deux pixels ne montrait
                             pas. Le dégradé est posé en code, dans la teinte de la
                             molécule. -->
                        <chart:SplineAreaSeries x:Name="ConcentrationSeries"
                                                ItemsSource="{Binding ChartData}"
                                                XBindingPath="Time"
                                                YBindingPath="Concentration"
                                                StrokeWidth="2.5"
                                                EnableAnimation="False"
                                                EnableTooltip="True" />
                    </chart:SfCartesianChart>

                    <!-- La légende porte les noms des seuils, leur couleur et leur
                         motif de trait. C'est elle qui les nomme désormais : les
                         quatre libellés écrits sur la courbe étaient ancrés à la
                         même abscisse et s'y empilaient en une tache. -->
                    <FlexLayout x:Name="ThresholdLegend"
                                Wrap="Wrap" JustifyContent="Start" AlignItems="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== 4. Historique ===== -->
            <Border x:Name="HistoryCard" Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="HistoryTitleLabel"
                           Text="Prises récentes"
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,0,0,6"
                           SemanticProperties.HeadingLevel="Level2" />

                    <Label x:Name="EmptyDosesLabel"
                           Text="Aucune prise enregistrée"
                           Style="{StaticResource EmptyLabelStyle}" />

                    <CollectionView x:Name="DosesCollection"
                                    ItemsSource="{Binding Doses}"
                                    MaximumHeightRequest="340">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Grid Style="{StaticResource DoseRowStyle}"
                                          ColumnDefinitions="*,Auto,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding TimeTaken, StringFormat='{0:ddd dd/MM · HH:mm}'}"
                                                   Style="{StaticResource BodyLabelStyle}" />
                                            <Label Text="{Binding BeverageType}"
                                                   Style="{StaticResource HelperLabelStyle}"
                                                   IsVisible="{Binding BeverageType, Converter={StaticResource IsNotEmptyConverter}}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding AmountDisplay}"
                                               Style="{StaticResource BodyLabelStyle}"
                                               FontFamily="OpenSansSemibold"
                                               VerticalTextAlignment="Center" />

                                        <Button Grid.Column="2"
                                                Text="✕"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnDeleteRowClicked"
                                                SemanticProperties.Description="Supprimer cette prise" />
                                    </Grid>

                                    <BoxView Style="{StaticResource SeparatorStyle}" Opacity="0.4" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ===== 5. Données ===== -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Button x:Name="DataToggleButton"
                            Style="{StaticResource DisclosureButtonStyle}"
                            Clicked="OnDataToggleClicked" />

                    <VerticalStackLayout x:Name="DataSection" Spacing="10" IsVisible="False">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="ImportButton" Grid.Column="0"
                                    Text="Importer"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="ExportButton" Grid.Column="1"
                                    Text="Exporter"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <Button x:Name="ClearButton"
                                Text="Tout effacer"
                                Style="{StaticResource DangerButtonStyle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
