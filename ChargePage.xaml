<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoleculeEfficienceTracker.ChargePage"
             Title="Charge"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <DataTemplate x:Key="StatRowTemplate">
            <Grid ColumnDefinitions="4,*,Auto,Auto" ColumnSpacing="10" Padding="0,8">
                <!-- Le filet coloré identifie la molécule ; le nom la nomme.
                     La couleur ne porte jamais l'information seule. -->
                <BoxView Grid.Column="0" WidthRequest="4" CornerRadius="2"
                         Color="{Binding Accent}" />

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{Binding MoleculeName}" Style="{StaticResource BodyLabelStyle}" />
                    <Label Text="{Binding Detail}" Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <Label Grid.Column="2" Text="{Binding AverageDisplay}"
                       Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold"
                       VerticalTextAlignment="Center" />

                <Label Grid.Column="3" Text="{Binding VariationDisplay}"
                       TextColor="{Binding VariationColor}"
                       FontSize="13" VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">

            <Label Text="Moyennes journalières"
                   Style="{StaticResource SectionTitleStyle}"
                   FontSize="22"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label x:Name="SummaryLabel" Style="{StaticResource CaptionLabelStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Dernières 24 heures" Style="{StaticResource SectionTitleStyle}" />
                    <CollectionView x:Name="Stats1dCollection" ItemTemplate="{StaticResource StatRowTemplate}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="7 derniers jours" Style="{StaticResource SectionTitleStyle}" />
                    <CollectionView x:Name="Stats7dCollection" ItemTemplate="{StaticResource StatRowTemplate}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="30 derniers jours" Style="{StaticResource SectionTitleStyle}" />
                    <CollectionView x:Name="Stats30dCollection" ItemTemplate="{StaticResource StatRowTemplate}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
