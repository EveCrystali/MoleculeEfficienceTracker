<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Rôles de couleur Material 3, la convention du système sur lequel cette
        application tourne. La version précédente inventait sa propre nomenclature
        — quatre violets « de marque » sans lien, vingt-six valeurs hexadécimales
        écrites dans les pages — et la moitié des jetons ne servait plus.

        Chaque rôle porte un couple clair / sombre, et les styles s'y branchent par
        AppThemeBinding. Un seul endroit décide de la couleur.

        Contrainte de lecture : bleu, orange, rouge. Aucun vert ne porte de sens,
        la lecture rouge/vert étant inaccessible en deutéranopie. La teinte source
        est #1F5FAF ; la palette secondaire a été tournée vers l'orange plutôt que
        vers le vert que produirait l'harmonisation par défaut.

        Voir aussi Platforms\Android\Resources\values\colors.xml.
    -->

    <!-- ===== Primaire — l'action, le niveau « léger » ===== -->
    <Color x:Key="PrimaryLight">#1F5FAF</Color>
    <Color x:Key="PrimaryDark">#A8C7FA</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#0A305F</Color>
    <Color x:Key="PrimaryContainerLight">#D6E3FF</Color>
    <Color x:Key="PrimaryContainerDark">#2C4B6F</Color>
    <Color x:Key="OnPrimaryContainerLight">#001C38</Color>
    <Color x:Key="OnPrimaryContainerDark">#D6E3FF</Color>

    <!-- ===== Secondaire — l'orange, le niveau « net » ===== -->
    <Color x:Key="SecondaryLight">#8A5300</Color>
    <Color x:Key="SecondaryDark">#FFB95C</Color>
    <Color x:Key="OnSecondaryLight">#FFFFFF</Color>
    <Color x:Key="OnSecondaryDark">#4A2800</Color>
    <Color x:Key="SecondaryContainerLight">#FFDDB7</Color>
    <Color x:Key="SecondaryContainerDark">#5F3B00</Color>
    <Color x:Key="OnSecondaryContainerLight">#2C1600</Color>
    <Color x:Key="OnSecondaryContainerDark">#FFDDB7</Color>

    <!-- ===== Erreur — le rouge, le niveau « fort » ===== -->
    <Color x:Key="ErrorLight">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>
    <Color x:Key="OnErrorLight">#FFFFFF</Color>
    <Color x:Key="OnErrorDark">#601410</Color>
    <Color x:Key="ErrorContainerLight">#F9DEDC</Color>
    <Color x:Key="ErrorContainerDark">#8C1D18</Color>
    <Color x:Key="OnErrorContainerLight">#410E0B</Color>
    <Color x:Key="OnErrorContainerDark">#F9DEDC</Color>

    <!--
        ===== Surfaces =====

        Material 3 remplace l'ombre par l'élévation tonale : une carte ne se
        détache pas par une bordure ni par une ombre portée, mais par une surface
        un peu plus teintée que le fond. C'est ce qui faisait ressembler chaque
        écran à un formulaire — un contour gris de 1 px autour de tout.
    -->
    <Color x:Key="SurfaceLight">#FCFCFF</Color>
    <Color x:Key="SurfaceDark">#111418</Color>
    <Color x:Key="SurfaceContainerLowLight">#F5F5F9</Color>
    <Color x:Key="SurfaceContainerLowDark">#191C20</Color>
    <Color x:Key="SurfaceContainerLight">#EFF1F5</Color>
    <Color x:Key="SurfaceContainerDark">#1D2024</Color>
    <Color x:Key="SurfaceContainerHighLight">#E9ECF0</Color>
    <Color x:Key="SurfaceContainerHighDark">#282A2E</Color>
    <Color x:Key="SurfaceContainerHighestLight">#E3E6EA</Color>
    <Color x:Key="SurfaceContainerHighestDark">#323539</Color>

    <Color x:Key="OnSurfaceLight">#1A1C1E</Color>
    <Color x:Key="OnSurfaceDark">#E2E2E6</Color>
    <Color x:Key="OnSurfaceVariantLight">#43474E</Color>
    <Color x:Key="OnSurfaceVariantDark">#C3C7CF</Color>

    <Color x:Key="OutlineLight">#73777F</Color>
    <Color x:Key="OutlineDark">#8D9199</Color>
    <Color x:Key="OutlineVariantLight">#C3C7CF</Color>
    <Color x:Key="OutlineVariantDark">#43474E</Color>

    <!--
        ===== Niveaux d'effet =====

        Ils n'ont plus de palette propre : ils se branchent sur les rôles, si bien
        qu'une retouche de la palette les suit. Miroir exact de
        Core/Design/EffectPalette.cs — les deux fichiers doivent dire la même chose.

        Négligeable → onSurfaceVariant · Léger → primary
        Net         → secondary        · Fort  → error
    -->
    <Color x:Key="EffectNoneLight">#43474E</Color>
    <Color x:Key="EffectNoneDark">#C3C7CF</Color>
    <Color x:Key="EffectLightLight">#1F5FAF</Color>
    <Color x:Key="EffectLightDark">#A8C7FA</Color>
    <Color x:Key="EffectModerateLight">#8A5300</Color>
    <Color x:Key="EffectModerateDark">#FFB95C</Color>
    <Color x:Key="EffectStrongLight">#B3261E</Color>
    <Color x:Key="EffectStrongDark">#F2B8B5</Color>

    <!-- Fonds des puces d'état : le conteneur du rôle, jamais le rôle plein. -->
    <Color x:Key="EffectNoneContainerLight">#E3E6EA</Color>
    <Color x:Key="EffectNoneContainerDark">#323539</Color>
    <Color x:Key="EffectLightContainerLight">#D6E3FF</Color>
    <Color x:Key="EffectLightContainerDark">#2C4B6F</Color>
    <Color x:Key="EffectModerateContainerLight">#FFDDB7</Color>
    <Color x:Key="EffectModerateContainerDark">#5F3B00</Color>
    <Color x:Key="EffectStrongContainerLight">#F9DEDC</Color>
    <Color x:Key="EffectStrongContainerDark">#8C1D18</Color>

    <!-- Grille du graphique : la même valeur que outlineVariant. -->
    <Color x:Key="GridLineLight">#C3C7CF</Color>
    <Color x:Key="GridLineDark">#43474E</Color>

    <!--
        ===== Verre =====

        Une carte de verre n'est pas une carte floutée : ni RenderEffect ni
        BLUR_BEHIND ne sont exposés par MAUI pour une vue quelconque sur Android.
        Elle se fabrique de trois ingrédients, et c'est ainsi qu'elle se fabrique
        partout ailleurs en production.

        Une surface translucide, d'abord, posée sur un fond qui a quelque chose à
        laisser voir — d'où le dégradé de page ci-dessous. Un filet clair ensuite,
        sur l'arête, qui imite la tranche éclairée du verre. Une ombre souple
        enfin, large et peu opaque, qui décolle la carte du fond.

        Ôte l'un des trois et l'illusion tombe : sans dégradé derrière, la
        translucidité ne se voit pas ; sans filet, la carte redevient un
        rectangle gris ; sans ombre, elle reste collée au fond.
    -->
    <Color x:Key="GlassFillLight">#D9FFFFFF</Color>
    <Color x:Key="GlassFillDark">#1AFFFFFF</Color>
    <Color x:Key="GlassFillStrongLight">#F2FFFFFF</Color>
    <Color x:Key="GlassFillStrongDark">#26FFFFFF</Color>
    <Color x:Key="GlassStrokeLight">#B3FFFFFF</Color>
    <Color x:Key="GlassStrokeDark">#26FFFFFF</Color>
    <Color x:Key="GlassShadowLight">#334A6B99</Color>
    <Color x:Key="GlassShadowDark">#66000000</Color>

    <!--
        ===== Fond de page =====

        Trois arrêts, très peu saturés : le verre a besoin d'un fond qui varie pour
        se lire comme du verre. Un aplat uni rendrait la translucidité invisible.
    -->
    <LinearGradientBrush x:Key="PageGradientLight" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#E6EFFC" Offset="0.0" />
        <GradientStop Color="#F5F3FB" Offset="0.45" />
        <GradientStop Color="#FDF4F1" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PageGradientDark" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#0A1018" Offset="0.0" />
        <GradientStop Color="#12131E" Offset="0.45" />
        <GradientStop Color="#1A1219" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Pinceaux, pour les propriétés qui n'acceptent pas une Color. -->
    <SolidColorBrush x:Key="PrimaryBrushLight" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="PrimaryBrushDark" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

</ResourceDictionary>
