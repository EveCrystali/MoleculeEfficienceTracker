<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Voir aussi Platforms\Android\Resources\values\colors.xml -->

    <!--
        Vingt-six valeurs hexadécimales vivaient auparavant dans les pages, hors de
        tout dictionnaire, et quatre violets « de marque » coexistaient sans lien.
        Tout passe désormais par les jetons ci-dessous.

        Contrainte de lecture : rouge, orange et bleu seulement. Aucun vert ne porte
        de sens, la lecture rouge/vert étant inaccessible en deutéranopie.
    -->

    <!-- Marque -->
    <Color x:Key="Primary">#1F5FAF</Color>
    <Color x:Key="PrimaryDark">#5A9BE6</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#B86A00</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#C0392B</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#12171D</Color>
    <Color x:Key="MidnightBlue">#0E1A2B</Color>

    <Color x:Key="Gray100">#E6EAEF</Color>
    <Color x:Key="Gray200">#CDD5DE</Color>
    <Color x:Key="Gray300">#AEB9C6</Color>
    <Color x:Key="Gray400">#8B98A6</Color>
    <Color x:Key="Gray500">#5B6B7C</Color>
    <Color x:Key="Gray600">#3D4A58</Color>
    <Color x:Key="Gray900">#1B222B</Color>
    <Color x:Key="Gray950">#12171D</Color>

    <!-- Surfaces -->
    <Color x:Key="PageBackgroundLight">#F7F9FC</Color>
    <Color x:Key="PageBackgroundDark">#12171D</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1B222B</Color>
    <Color x:Key="CardStrokeLight">#E1E7EF</Color>
    <Color x:Key="CardStrokeDark">#2C3743</Color>
    <Color x:Key="FieldBackgroundLight">#EDF3FA</Color>
    <Color x:Key="FieldBackgroundDark">#232C37</Color>

    <!-- Texte -->
    <Color x:Key="TextPrimaryLight">#12171D</Color>
    <Color x:Key="TextPrimaryDark">#EEF2F7</Color>
    <Color x:Key="TextSecondaryLight">#5B6B7C</Color>
    <Color x:Key="TextSecondaryDark">#9BA8B6</Color>

    <!-- Niveaux d'effet — miroir XAML de Core/Design/EffectPalette.cs -->
    <Color x:Key="EffectNoneLight">#5B6B7C</Color>
    <Color x:Key="EffectNoneDark">#93A1B0</Color>
    <Color x:Key="EffectLightLight">#1F6FB2</Color>
    <Color x:Key="EffectLightDark">#5AA9E6</Color>
    <Color x:Key="EffectModerateLight">#B86A00</Color>
    <Color x:Key="EffectModerateDark">#E8A33D</Color>
    <Color x:Key="EffectStrongLight">#C0392B</Color>
    <Color x:Key="EffectStrongDark">#F07167</Color>

    <!-- Grille et axes -->
    <Color x:Key="GridLineLight">#E1E7EF</Color>
    <Color x:Key="GridLineDark">#2C3743</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
