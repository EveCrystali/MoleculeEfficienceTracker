<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Styles communs. Deux changements de fond par rapport à la version
        précédente.

        Frame a disparu : le contrôle est obsolète depuis MAUI 9 et l'application en
        comptait trente-neuf. Border le remplace partout.

        Chaque couleur suit le thème. Les pages forçaient auparavant un fond clair en
        dur tandis que le style global peignait les libellés en blanc au thème
        sombre : la liste des doses de l'écran alcool s'écrivait en blanc sur blanc.
    -->

    <!-- ===== Surfaces ===== -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageRootLayoutStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="14" />
        <Setter Property="Padding" Value="16,16,16,32" />
        <Setter Property="MaximumWidthRequest" Value="720" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- ===== Texte ===== -->

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="BodyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="CaptionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <!-- La réponse en une phrase, en tête de l'écran caféine. -->
    <Style x:Key="HeadlineAnswerStyle" TargetType="Label">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="BigStatLabel" TargetType="Label">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="EmptyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Italic" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <!-- ===== Actions ===== -->

    <!-- 48 px de haut : le style global annonçait un minimum de 44 que les boutons
         de l'application contredisaient à 28. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#0E1620}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="PresetButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldBackgroundLight}, Dark={StaticResource FieldBackgroundDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="MinimumHeightRequest" Value="60" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style x:Key="DeleteButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource EffectStrongDark}}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===== Champs ===== -->

    <Style x:Key="FieldBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource FieldBackgroundLight}, Dark={StaticResource FieldBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="FieldEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- ===== Liste des doses ===== -->

    <Style x:Key="DoseRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource FieldBackgroundDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

</ResourceDictionary>
