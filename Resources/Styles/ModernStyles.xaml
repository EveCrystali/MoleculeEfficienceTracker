<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Le dictionnaire unique de l'application.

        Trois décisions le gouvernent, et chacune répond à un défaut précis des
        écrans précédents.

        La police. Nunito remplace Open Sans, sur quatre graisses au lieu de deux.
        Open Sans à 14 sur du gris, c'est la police d'un formulaire ; une grotesque
        aux terminaisons arrondies, avec un écart franc entre le 800 d'un chiffre
        et le 400 de sa légende, c'est la police d'une application qu'on ouvre le
        matin. Le contraste de graisse fait ici plus de travail que le contraste de
        taille : un même corps de 14 se lit comme deux niveaux différents selon
        qu'il pèse 400 ou 700.

        L'opacité. Les cartes cessent d'être translucides. Une carte de verre pose
        sa transparence sur le fond et finit à deux points de luminosité de lui —
        d'où l'uniformité grise dont se plaignaient les captures. Une carte blanche
        franche, posée sur un fond réellement teinté, se détache d'elle-même.

        La variété. Une carte, un titre et un paragraphe répétés cinq fois, c'est
        une liste, pas un écran. Il y a désormais quatre formes distinctes — la
        carte de tête colorée, la vignette de mesure, la carte de section, la ligne
        de liste — et chacune dit par sa forme le rang de ce qu'elle porte.

        Échelle : 34 pour un chiffre qui doit se lire de loin et au centre de
        l'anneau, 21 pour la phrase-réponse, 17 pour un titre de section, 15 pour
        le corps, 13 pour le secondaire, 12 pour l'aide et les puces.
        Espacements sur la grille de 4. Rayons : carte 26, vignette 22, puce ovale.
    -->

    <!-- ================================================================= -->
    <!-- 1. Styles implicites                                               -->
    <!-- ================================================================= -->

    <!-- Le fond est un dégradé, non un aplat. Background, et non
         BackgroundColor, sans quoi la couleur unie l'emporterait. -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource PageGradientLight}, Dark={StaticResource PageGradientDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- Bouton plein : coins entièrement arrondis, 48 px de haut, libellé en
         gras. Un bouton d'action qui ne pèse pas plus que le texte autour de lui
         ne se voit pas comme un bouton. -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerHighestLight}, Dark={StaticResource SurfaceContainerHighestDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
    </Style>

    <!--
        Champs de saisie.

        Volontairement réduits à la lisibilité du texte : police, couleur, taille,
        hauteur de touche. Ni fond ni bordure, pour laisser Material 3 poser son
        propre conteneur — ce que la propriété de compilation UseMaterial3 active
        sur Android pour Entry, Editor, Picker, DatePicker, TimePicker, Slider et
        RadioButton. Poser ici une couleur de fond reviendrait à l'écraser.
    -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="FontFamily" Value="Sans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light=#D7E9FB, Dark=#0B1220}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#171A21}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- ================================================================= -->
    <!-- 2. Échelle typographique                                           -->
    <!-- ================================================================= -->

    <!--
        Le chiffre d'une vignette. Trente-quatre points en 800 : c'est le seul
        élément de la vignette qui se lit à bout de bras, et il doit le rester. La
        version précédente plafonnait à trente en 600, si bien que la valeur du
        moment pesait à peine plus que le titre qui l'annonçait. Trente-quatre est
        aussi le plafond praticable — au-delà, « 1 040 » déborde une vignette de
        demi-largeur sur un écran de 360.
    -->
    <Style x:Key="MetricValueStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansHeavy" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="LineHeight" Value="1.05" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- La valeur au centre de l'anneau : plus petite que la vignette, l'anneau
         occupant déjà la place. -->
    <Style x:Key="DisplayValueStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansHeavy" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="LineHeight" Value="1.0" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- L'unité sous la valeur : trois fois plus petite, jamais en gras. Une
         unité de la taille de son nombre lui dispute la lecture. -->
    <Style x:Key="DisplayUnitStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansMedium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- La phrase-réponse, en tête d'écran. -->
    <Style x:Key="HeadlineAnswerStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- Titre de carte ou de section. -->
    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <!-- Le titre d'une vignette : petit, gris, au-dessus du chiffre. Il nomme, il
         ne pèse pas — c'est le chiffre qu'on vient lire. -->
    <Style x:Key="TileTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- Le corps. -->
    <Style x:Key="BodyLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansMedium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Le secondaire. -->
    <Style x:Key="CaptionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- L'aide, les légendes. -->
    <Style x:Key="HelperLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- Le texte d'une puce : court, gras, petit. Sa couleur est posée en code,
         celle du niveau qu'elle nomme. -->
    <Style x:Key="ChipLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- L'état vide : une phrase, pas un cadre vide. -->
    <Style x:Key="EmptyLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- ================================================================= -->
    <!-- 3. Surfaces                                                        -->
    <!-- ================================================================= -->

    <!--
        La carte de section : blanche, opaque, rayon 26, ombre bleutée et basse.

        L'ombre ne sert pas à faire joli — elle sépare. Sans elle, une carte
        blanche sur un fond très clair n'a pour frontière qu'un changement de deux
        points de luminosité, que l'œil ne voit pas. Décalée vers le bas et
        largement floue, elle pose la carte au-dessus du fond plutôt que de la
        cerner d'un trait.
    -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CardGradientLight}, Dark={StaticResource CardGradientDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource CardShadowLight}, Dark={StaticResource CardShadowDark}}"
                        Offset="0,8" Radius="20" Opacity="0.13" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        La vignette : même matière, plus petite, plus arrondie. Deux par rangée,
        largeur partagée. C'est la forme qui manquait le plus — une colonne de
        cartes identiques de la largeur de l'écran donne un formulaire ; deux
        vignettes côte à côte donnent un tableau de bord.
    -->
    <Style x:Key="TileCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--
        La carte de tête. Son fond est réécrit en code avec la teinte de marque de
        la molécule, pleine et non diluée, et son texte passe au blanc. C'est elle
        qui donne sa couleur à l'écran : les cinq pages se ressemblaient en gris,
        le café s'ouvre maintenant sur de l'orange et l'alcool sur du rouge.
    -->
    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="22" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource CardShadowLight}, Dark={StaticResource CardShadowDark}}"
                        Offset="0,10" Radius="26" Opacity="0.22" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Une carte sans ombre ni fond, pour grouper sans ajouter de niveau. -->
    <Style x:Key="SubtleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="PageRootLayoutStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="14" />
        <Setter Property="Padding" Value="16,10,16,36" />
        <Setter Property="MaximumWidthRequest" Value="720" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- ================================================================= -->
    <!-- 4. Pastilles et puces                                              -->
    <!-- ================================================================= -->

    <!--
        La pastille d'icône : un disque coloré de 36 px portant un glyphe blanc.
        Empruntée à Samsung Health, où chaque mesure en porte une. Elle fait deux
        choses à la fois — elle identifie la ligne d'un coup d'œil, et elle pose
        de la couleur là où une liste n'en a jamais.
    -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BadgeGlyphStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- L'enveloppe ovale d'une puce d'état. Son fond vient du conteneur du
         niveau, posé en code. -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ================================================================= -->
    <!-- 5. Actions                                                         -->
    <!-- ================================================================= -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <!-- Les doses en accès direct. Fond et contour sont teintés en code de la
         couleur de la molécule, l'opacité croissant avec la dose. -->
    <Style x:Key="PresetButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
        <Setter Property="FontFamily" Value="SansHeavy" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="MinimumHeightRequest" Value="60" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="Padding" Value="4,0" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- Action destructrice : le texte prend le rôle error, jamais le fond. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
    </Style>

    <Style x:Key="DeleteButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- L'en-tête d'un volet repliable : un bouton qui ne ressemble pas à un
         bouton, aligné à gauche, du poids d'un titre de section. -->
    <Style x:Key="DisclosureButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontFamily" Value="SansBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- ================================================================= -->
    <!-- 6. Champs                                                          -->
    <!-- ================================================================= -->

    <!--
        Il n'y a pas de style de champ, et c'est le but.

        Sous Material 3, le gestionnaire Android rend l'Entry, l'Editor, le Picker,
        le DatePicker et le TimePicker avec un TextInputLayout à contour et libellé
        flottant. Les envelopper dans une bordure remplie dessinerait une boîte
        dans une boîte ; poser une couleur de fond écraserait le conteneur natif.
        Ne restent que les styles implicites de la section 1.
    -->

    <!-- ================================================================= -->
    <!-- 7. Listes                                                          -->
    <!-- ================================================================= -->

    <!-- Une ligne d'historique n'est pas une carte : ni fond, ni cadre. Trente
         cartes empilées ne hiérarchisent rien. -->
    <Style x:Key="DoseRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="SeparatorStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}" />
    </Style>

</ResourceDictionary>
